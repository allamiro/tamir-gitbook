}}}}}}}},"[":{"docs":{},"\"":{"docs":{},"s":{"docs":{},"e":{"docs":{},"a":{"docs":{},"r":{"docs":{},"c":{"docs":{},"h":{"docs":{},"\"":{"docs":{},",":{"docs":{"chapter-2/configuration.html":{"ref":"chapter-2/configuration.html","tf":0.010526315789473684}}}}}}}}}}}},"{":{"docs":{"chapter-2/configuration.html":{"ref":"chapter-2/configuration.html","tf":0.042105263157894736}}},"}":{"docs":{"chapter-2/configuration.html":{"ref":"chapter-2/configuration.html","tf":0.042105263157894736}}}},"length":185},"corpusTokens":["\"a4\"","\"arial\",","\"author","\"author\":","\"en\",","\"fontfamily\":","\"fontsize\":","\"language\":","\"mi","\"pagenumbers\":","\"papersize\":","\"pdf\":","\"plugins\":","\"pluginsconfig\":","\"showlevel\":","\"theme","\"title\":","(includ",".","1","1.","12,","2","2.","4000:4000","[\"search\",","add","advanc","allow","alternatively,","automat","back","basic","befor","begin,","block","book","book\",","book.json","book:","build","button","button:","chapter","chapters:","cli","cli.","clone","code","command","command:","commands:","compos","configur","configuration:","contain","copi","cover","creation","custom","d","default\":","default\"],","default)","docker","ecosystem","enhanc","epub","expand","expandable/collaps","experi","expos","fast","featur","features.","file.","find","first","flexibl","follow","function","g","gener","get","git","gitbook","gitbook.","gitbook.git","guid","help","here","here'","highlight","highlight:","host","http://localhost:4000.","https://github.com/allamiro/tamir","imag","image,","image:","includ","inform","init","initi","instal","introduct","learn","lightweight","like:","machine.","make","map","minim","more","name\",","node.j","npm","npm:","optim","option","output,","p","pdf","plugin","prerequisit","preview","project","repositori","resourc","respositori","rich","run","sampl","seamless","search","search:","serv","server","server,","setup","singl","start","sure","syntax","t","tamir","top","true","true,","up","us","usage.","version","wiki","wikis,","you'll","{","}"],"pipeline":["stopWordFilter","stemmer"]},"store":{"./":{"url":"./","title":"Introduction","keywords":"","body":"Tamir-gitbook\nA lightweight Docker image for hosting GitBook wikis, optimized for fast setup and minimal resource usage. Includes GitBook CLI for seamless book creation and serving on Node.js\nGitBook Docker Project\nThis repository contains a Docker setup for building and serving a GitBook using Node.js and GitBook CLI.\nPrerequisites\nBefore you begin, make sure you have Docker and Docker Compose installed on your machine.\n\nDocker Installation\nDocker Compose Installation\n\nBuild and Run with Docker\n1. Build the Docker Image\nClone the respository\n\ngit clone https://github.com/allamiro/tamir-gitbook.git\n\nRun the following command to build the Docker image:\ndocker build -t tamir-gitbook-wiki .\n\n2. Server the Gitbook\ndocker run -p 4000:4000 tamir-gitbook-wiki\n\nThis will expose the GitBook server at http://localhost:4000.\nUse Docker Compose\nAlternatively, you can use docker-compose to build and run the project with a single command:\n\ndocker-compose up -d\n\nThis will automatically build the image, start the GitBook server, and map it to http://localhost:4000.\n"},"chapter-1/":{"url":"chapter-1/","title":"Chapter 1","keywords":"","body":"Chapter 1\nThis is the first chapter of your GitBook.\nHere you will find information about getting started with GitBook.\n"},"chapter-1/getting-started.html":{"url":"chapter-1/getting-started.html","title":"Getting Started","keywords":"","body":"Getting Started\nThis guide will help you get started with GitBook.\nInstallation\nGitBook can be installed using npm:\nnpm install -g gitbook-cli\n\nBasic Commands\nHere are some basic GitBook commands:\n\ngitbook init - Initialize a book\ngitbook serve - Serve a book for preview\ngitbook build - Build a book\ngitbook pdf - Generate a PDF version\ngitbook epub - Generate an ePub version\n\n"},"chapter-2/":{"url":"chapter-2/","title":"Chapter 2","keywords":"","body":"Chapter 2\nThis chapter covers configuration options and advanced features of GitBook.\nYou'll learn how to customize your GitBook experience and use more advanced features.\n"},"chapter-2/configuration.html":{"url":"chapter-2/configuration.html","title":"Configuration","keywords":"","body":"Configuration\nGitBook allows you to customize your book using a flexible configuration in the book.json file.\nBasic Configuration\nHere's a sample book.json configuration:\n{\n  \"title\": \"My Book\",\n  \"author\": \"Author Name\",\n  \"language\": \"en\",\n  \"plugins\": [\"search\", \"theme-default\"],\n  \"pluginsConfig\": {\n    \"theme-default\": {\n      \"showLevel\": true\n    }\n  }\n}\n\nPlugins\nGitBook has a rich ecosystem of plugins that can enhance your book:\n\nsearch: Add search functionality (included by default)\nhighlight: Syntax highlighting for code blocks\nexpandable-chapters: Make chapters expandable/collapsible\nback-to-top-button: Add a back-to-top button\ncopy-code-button: Add a copy button to code blocks\n\nPDF Configuration\nFor PDF output, you can configure options like:\n\"pdf\": {\n  \"pageNumbers\": true,\n  \"fontSize\": 12,\n  \"fontFamily\": \"Arial\",\n  \"paperSize\": \"a4\"\n}\n\n"}}}