{
  "title": "Tamir GitBook Wiki",
  "description": "A lightweight Docker-based GitBook wiki",
  "author": "Tamir Suliman",
  "language": "en",
  "structure": {
    "readme": "intro.md"
  },
  "styles": {
    "website": "themes/modern.css"
  },
  "plugins": [
    "-sharing",
    "search",
    "theme-default",
    "expandable-chapters",
    "highlight",
    "back-to-top-button",
    "site-footer"
  ],
  "pluginsConfig": {
    "theme-default": {
      "showLevel": true
    },
    "site-footer": {
      "author": "Tamir Suliman",
      "url": "https://github.com/allamiro",
      "poweredBy": true
    }
  },
  "pdf": {
    "pageNumbers": true,
    "fontSize": 12,
    "fontFamily": "Arial",
    "paperSize": "a4"
  }
}
